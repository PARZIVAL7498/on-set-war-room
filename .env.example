# ClickHouse Cloud — copy to .env and fill in real values.
# Never commit .env.

CLICKHOUSE_HOST=your-service.region.provider.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=on_set_war_room
CLICKHOUSE_SECURE=true

# Required for live ADK LLM turns (Gemini). Without a key, the pipeline still
# runs google-adk SequentialAgent tool choreography against ClickHouse.
GOOGLE_API_KEY=
# GEMINI_API_KEY=   # accepted as alias for GOOGLE_API_KEY
GEMINI_MODEL=gemini-3.6-flash
