# ClickHouse Cloud — copy to .env and fill in real values.
# Never commit .env.

CLICKHOUSE_HOST=your-service.region.provider.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=on_set_war_room
CLICKHOUSE_SECURE=true

# Optional — Gemini narration only (deterministic engines always run without this)
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
